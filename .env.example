GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VIDEO_MODEL=gemini-2.5-flash-image
# Optional custom endpoint, supports {model} placeholder
# GEMINI_ENDPOINT=https://www.dmxapi.cn/v1beta/models/{model}:generateContent
# Optional custom video endpoint, supports {model} placeholder
# GEMINI_VIDEO_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateVideos
# Optional custom operation polling endpoint, supports {operation} placeholder
# GEMINI_VIDEO_OPERATION_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/{operation}
# auth mode: auto | query | bearer | header | none
GEMINI_API_KEY_MODE=auto
# used when GEMINI_API_KEY_MODE=header
GEMINI_KEY_HEADER=x-api-key
GEMINI_TIMEOUT_MS=50000
GEMINI_IMAGE_TIMEOUT_MS=90000
GEMINI_VIDEO_TIMEOUT_MS=90000
GEMINI_VIDEO_POLL_INTERVAL_MS=2500
GEMINI_VIDEO_MAX_WAIT_MS=300000
PORT=8787
